generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  title     String
  titleEn   String?
  summary   String
  summaryEn String?  @db.Text
  stack     String
  outcome   String?
  outcomeEn String?
  href      String?
  featured  Boolean  @default(false)
  published Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PortfolioKind {
  EXPERIENCE
  COMMUNITY
  AWARD
  EDUCATION
  SKILL
  TALK
  INTEREST
}

model PortfolioEntry {
  id           String        @id @default(cuid())
  kind         PortfolioKind
  title        String
  titleEn      String?
  subtitle     String?
  subtitleEn   String?
  description  String        @db.Text
  descriptionEn String?      @db.Text
  organization String?
  period       String?
  location     String?
  tags         String?
  tagsEn       String?
  metric       String?
  metricEn     String?
  href         String?
  published    Boolean       @default(false)
  featured     Boolean       @default(false)
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([kind, title])
  @@index([kind, published, position])
}

model RateLimitBucket {
  id              String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model ContactVerification {
  id          String   @id
  email       String
  codeHash    String
  payloadHash String
  attempts    Int      @default(0)
  expiresAt   DateTime @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([email, createdAt])
}
