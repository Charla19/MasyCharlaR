# Local Docker database; replace with Neon, Supabase, or Vercel Postgres for production.
DATABASE_URL="postgresql://portfolio:portfolio@127.0.0.1:5433/portfolio?schema=public"

# Generate a long random value: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="masycharlar@gmail.com"
# Base64-encoded bcrypt hash; avoids $ interpolation in .env and Compose.
ADMIN_PASSWORD_HASH_B64="replace-with-base64-bcrypt-hash"
